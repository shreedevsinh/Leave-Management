datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "linux-musl", "rhel-openssl-3.0.x"]
  engineType    = "binary"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveAction {
  APPLIED
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
}

model User {
  id       String @id
  name     String
  email    String @unique
  mobile   String @default("")
  password String
  role     Role   @default(EMPLOYEE)

  // relations
  leaves   Leave[]
  balances LeaveBalance[]
  salaries Salary[]
  payrolls Payroll[]

  refreshToken String?
  isActive     Boolean @default(true)

  joinDate String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Leave {
  id     String      @id
  userId String
  typeId String
  status LeaveStatus @default(PENDING)

  startDate DateTime
  endDate   DateTime
  totalDays Float

  reason String?

  appliedAt DateTime @default(now())

  approvedBy      String?
  rejectionReason String?

  user User      @relation(fields: [userId], references: [id])
  type LeaveType @relation(fields: [typeId], references: [id])

  logs LeaveLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeaveType {
  id         String  @id
  name       String  @unique
  maxPerYear Int
  isPaid     Boolean @default(true)

  leaves   Leave[]
  balances LeaveBalance[]
}

model LeaveBalance {
  id        String @id
  userId    String
  typeId    String

  total     Float
  used      Float @default(0)
  remaining Float

  year      Int

  user      User      @relation(fields: [userId], references: [id])
  type      LeaveType @relation(fields: [typeId], references: [id])

  @@unique([userId, typeId, year])
}

model LeaveLog {
  id          String      @id
  leaveId     String
  action      LeaveAction
  performedBy String       // fixed type
  note        String?

  createdAt   DateTime        @default(now())

leave         Leave        @relation(fields: [leaveId], references: [id])
}

//
// 💰 SALARY HISTORY (increments tracking)
//
model Salary {
  id         String   @id
  userId     String

  baseSalary Float    // monthly salary

  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  isActive   Boolean  @default(true)

  @@unique([userId])
}

//
// 📊 MONTHLY PAYROLL (core calculation table)
//
model Payroll {
  id            String @id
  userId        String

  month         Int   // 1-12
  year          Int

  totalDays     Int   // e.g. 31
  workingDays   Int   // exclude Sat/Sun
  workingHours  Float // workingDays * 8

  leaveDays     Float @default(0)
  leaveHours    Float @default(0)

  payableDays   Float
  payableHours  Float

  baseSalary    Float
  finalSalary   Float

  generatedAt   DateTime @default(now())

  user          User @relation(fields: [userId], references: [id])

  @@unique([userId, month, year])
}


model Attendance {
  id        String   @id 
  userId    String

  date      DateTime

  checkIn   DateTime?
  checkOut  DateTime?

  workingHours  Float  @default(0) 
  lateHours     Float  @default(0) 

  status AttendanceStatus @default(PRESENT)

  note String?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}