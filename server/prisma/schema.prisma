datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "linux-musl", "rhel-openssl-3.0.x"]
  engineType = "binary"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveAction {
  APPLIED
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id        String   @id
  name      String
  email     String   @unique
  mobile    String   @default("")
  password  String
  role      Role     @default(EMPLOYEE)

  leaves    Leave[]
  balances  LeaveBalance[]

  refreshToken String?
  isActive  Boolean  @default(true)

  joinDate  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now()) 
}

model Leave {
  id          String      @id
  userId      String
  typeId      String
  status      LeaveStatus  @default(PENDING)

  startDate   DateTime
  endDate     DateTime
  totalDays   Float

  reason      String?

  appliedAt   DateTime     @default(now())

  approvedBy  String?         
  rejectionReason String?

  user        User         @relation(fields: [userId], references: [id])
  type        LeaveType    @relation(fields: [typeId], references: [id])

  logs        LeaveLog[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LeaveType {
  id          String   @id
  name        String   @unique
  maxPerYear  Int
  isPaid      Boolean  @default(true)

  leaves      Leave[]
  balances    LeaveBalance[]
}

model LeaveBalance {
  id        String   @id
  userId    String
  typeId    String

  total     Float
  used      Float    @default(0)
  remaining Float

  year      Int

  user      User      @relation(fields: [userId], references: [id])
  type      LeaveType @relation(fields: [typeId], references: [id])

  @@unique([userId, typeId, year])
}

model LeaveLog {
  id          String        @id
  leaveId     String
  action      LeaveAction
  performedBy Int
  note        String?

  createdAt   DateTime      @default(now())

  leave       Leave         @relation(fields: [leaveId], references: [id])
}