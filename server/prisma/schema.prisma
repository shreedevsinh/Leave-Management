datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveAction {
  APPLIED
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  mobile    String   @default("")
  password  String
  role      Role     @default(EMPLOYEE)

  leaves    Leave[]
  balances  LeaveBalance[]

  refreshToken String?
  isActive  Boolean  @default(true)

  joinDate  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now()) 
}

model Leave {
  id          Int          @id @default(autoincrement())
  userId      Int
  typeId      Int
  status      LeaveStatus  @default(PENDING)

  startDate   DateTime
  endDate     DateTime
  totalDays   Float

  reason      String?

  appliedAt   DateTime     @default(now())

  approvedBy  Int?         
  rejectionReason String?

  user        User         @relation(fields: [userId], references: [id])
  type        LeaveType    @relation(fields: [typeId], references: [id])

  logs        LeaveLog[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LeaveType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  maxPerYear  Int
  isPaid      Boolean  @default(true)

  leaves      Leave[]
  balances    LeaveBalance[]
}

model LeaveBalance {
  id        Int      @id @default(autoincrement())
  userId    Int
  typeId    Int

  total     Float
  used      Float    @default(0)
  remaining Float

  year      Int

  user      User      @relation(fields: [userId], references: [id])
  type      LeaveType @relation(fields: [typeId], references: [id])

  @@unique([userId, typeId, year])
}

model LeaveLog {
  id          Int          @id @default(autoincrement())
  leaveId     Int
  action      LeaveAction
  performedBy Int
  note        String?

  createdAt   DateTime @default(now())

  leave       Leave @relation(fields: [leaveId], references: [id])
}